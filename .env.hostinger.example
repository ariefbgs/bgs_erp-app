APP_NAME="ERP BGS New"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://configure-domain.invalid

LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=configure_new_database
DB_USERNAME=configure_application_user
DB_PASSWORD=

# Empty only for a new identity space. Existing legacy IDs need explicit review.
BGS_RESTRICTED_FULL_USER_IDS=""
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=configure-mail@example.invalid
MAIL_FROM_NAME="ERP BGS New"
